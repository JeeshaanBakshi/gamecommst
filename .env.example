# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Either the new publishable key (sb_publishable_...) or the legacy anon key works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: force the URL encoded in the QR code (e.g. your Vercel domain or a LAN IP
# like http://192.168.1.20:3000 when testing phones against `npm run dev`).
NEXT_PUBLIC_SITE_URL=
